    {
      "dot": "emerald",
      "title": "Shipped and proven",
      "items": [
        "Generic extraction + 4 next-chapter strategies already work on arbitrary sites",
        "Dual TTS behind one interface, streaming with 12 s generation-ahead",
        "Ad-block engine, in-process audio and screen-off MediaSession are live"
      ]
    },
    {
      "dot": "amber",
      "title": "v1.2 closes the loop",
      "items": [
        "Persist position and build a local library (biggest competitor gap)",
        "Share/Clipboard intake turns NovelSpeak into a reader for any text",
        "Sleep timer, true per-site settings, diagnostics; positioning rewrite"
      ]
    },
    {
      "dot": "cyan",
      "title": "v1.3 parity plus",
      "items": [
        "Chapter prefetch removes the next-chapter stall",
        "Pronunciation rules, typography, word-level highlight",
        "Signed OTA model catalog and audio export"
      ]
    },
    {
      "dot": "rose",
      "title": "Deliberately absent",
      "items": [
        "No account, no cloud TTS subscription, no credit meter",
        "No book-source rule DSL and no content storage (Legado precedent)",
        "No ad SDKs, no analytics, no store catalogue"
      ]
    }
