# Cloudflare Pages headers. GitHub Pages ignores this file; nothing on the site depends on it.
# Contract: docs/website/design-contract.md § Verification, docs/cloudflare-pages.md

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=600, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/media/*
  Cache-Control: public, max-age=86400

# The 404 is self-contained (it is served at unknown depths) and resolves its home link at run time.
/404.html
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; object-src 'none'
